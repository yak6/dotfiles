{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 12,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 0,

    "modules-left":   ["hyprland/workspaces", "hyprland/window"],
    "modules-center": [],
    "modules-right":  ["cpu", "custom/memory", "pulseaudio", "tray", "clock"],

    "hyprland/workspaces": {
        "format": "{id}",
        "persistent-workspaces": { "1": [], "2": [], "3": [], "4": [], "5": [] },
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    },

    "hyprland/window": {
        "format": "<span color='#5c5c5c'>›</span> {}",
        "max-length": 48,
        "separate-outputs": true,
        "rewrite": { "": "<span color='#5c5c5c'>› ~</span>" }
    },

    "clock": {
        "format": "<span color='#5c5c5c'>{0:%a %d.%m}</span> {0:%H:%M}",
        "format-alt": "<span color='#5c5c5c'>{0:%Y-%m-%d}</span> {0:%H:%M:%S}",
        "interval": 1,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "",
            "format": {
                "months":   "<span color='#d0d0d0'><b>{}</b></span>",
                "weekdays": "<span color='#5c5c5c'>{}</span>",
                "days":     "<span color='#d0d0d0'>{}</span>",
                "today":    "<span color='#f2f2f2'><b>{}</b></span>"
            }
        }
    },

    "cpu": {
        "interval": 3,
        "format": "<span color='#5c5c5c'>CPU</span> {usage}%"
    },

    "custom/memory": {
        "exec": "~/.config/waybar/scripts/memory.sh",
        "return-type": "json",
        "interval": 5,
        "format": "<span color='#5c5c5c'>MEM</span> {}"
    },

    "pulseaudio": {
        "format": "<span color='#5c5c5c'>VOL</span> <span color='#f2f2f2'>{icon}</span> {volume:>3}%",
        "format-muted": "<span color='#5c5c5c'>VOL ■■■■■■ mute</span>",
        "format-bluetooth": "<span color='#5c5c5c'>BT </span> <span color='#f2f2f2'>{icon}</span> {volume:>3}%",
        "format-icons": ["□□□□□□", "■□□□□□", "■■□□□□", "■■■□□□", "■■■■□□", "■■■■■□", "■■■■■■"],
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%",
        "max-volume": 100,
        "scroll-step": 2
    },
    "tray": {
        "icon-size": 14,
        "spacing": 8
    }
}
